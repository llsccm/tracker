{
  "name": "daxiaochao",
  "author": "yimadaOrz",
  "license": "GPL-3.0-or-later",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "format": "prettier --write ./src/**/*.{ts,js}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:tracker": "tsc -p tsconfig.tracker.json",
    "typecheck:replay": "tsc -p tests/replay/tsconfig.json",
    "test:tracker": "vitest run tests/tracker tests/contracts/pile-identity",
    "test:replay": "vitest run --config vitest.replay.tests.config.js",
    "replay:tracker": "vitest run --config vitest.replay.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.16",
    "vite-plugin-monkey": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
